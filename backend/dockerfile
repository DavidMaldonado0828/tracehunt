# Imagen base: Linux liviano con Python 3.12
FROM python:3.12-slim

# Carpeta de trabajo dentro del contenedor
WORKDIR /app

# Primero solo las dependencias (así Docker reutiliza esta capa si no cambian)
COPY backend/requirements.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# La API y la interfaz quedan separadas, pero se empaquetan juntas para servir /ui.
COPY backend/ ./backend/
COPY frontend/ ./frontend/
WORKDIR /app/backend

# Puerto en el que escucha la API dentro del contenedor
EXPOSE 8000

# Arranque: uvicorn escuchando en todas las interfaces
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
