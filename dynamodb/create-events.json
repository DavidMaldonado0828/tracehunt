      }
    },
    {
      "IndexName": "SourceIpTimestampIndex",
      "KeySchema": [
        {
          "AttributeName": "source_ip",
          "KeyType": "HASH"
        },
        {
          "AttributeName": "timestamp_event",
          "KeyType": "RANGE"
        }
      ],
      "Projection": {
        "ProjectionType": "ALL"
      }
    },
    {
      "IndexName": "UsernameTimestampIndex",
      "KeySchema": [
        {
          "AttributeName": "username_key",
          "KeyType": "HASH"
        },
        {
          "AttributeName": "timestamp_event",
          "KeyType": "RANGE"
        }
      ],
      "Projection": {
        "ProjectionType": "ALL"
      }
    },
    {
      "IndexName": "OwnerDateTimestampIndex",
      "KeySchema": [
        {
          "AttributeName": "owner_date_bucket",
          "KeyType": "HASH"
        },
        {
          "AttributeName": "timestamp_event",
