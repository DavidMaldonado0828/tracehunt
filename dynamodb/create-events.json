        },
        {
          "AttributeName": "timestamp_event",
          "KeyType": "RANGE"
        }
      ],
      "Projection": {
        "ProjectionType": "ALL"
      }
    },
    {
      "IndexName": "OwnerUsernameTimestampIndex",
      "KeySchema": [
        {
          "AttributeName": "owner_username_key",
          "KeyType": "HASH"
        },
        {
          "AttributeName": "timestamp_event",
          "KeyType": "RANGE"
        }
      ],
      "Projection": {
        "ProjectionType": "ALL"
      }
    }
