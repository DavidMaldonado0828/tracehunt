{
  "TableName": "Events",
  "AttributeDefinitions": [
    {
      "AttributeName": "event_id",
      "AttributeType": "S"
    },
    {
      "AttributeName": "date_bucket",
      "AttributeType": "S"
    },
    {
      "AttributeName": "timestamp_event",
      "AttributeType": "S"
    },
    {
      "AttributeName": "source_ip",
      "AttributeType": "S"
    },
    {
      "AttributeName": "username_key",
      "AttributeType": "S"
    },
    {
      "AttributeName": "owner_date_bucket",
      "AttributeType": "S"
    },
    {
      "AttributeName": "owner_source_ip",
      "AttributeType": "S"
    },
    {
      "AttributeName": "owner_username_key",
      "AttributeType": "S"
    }
